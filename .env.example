# Copy to .env and adjust. `make run` loads it automatically.
HTTP_ADDR=:8080

# Prometheus /metrics on a separate port; keep it off the public internet.
# Set to "off" to disable.
METRICS_ADDR=:9090

# Leave empty to use in-memory storage (data lost on restart).
DATABASE_URL=postgres://hub:hub@localhost:5432/hub?sslmode=disable

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts merchants' gateway credentials at rest. Do not lose or change it,
# or stored credentials become unreadable.
ENCRYPTION_KEY=

# Bearer token for POST /v1/merchants. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# debug, info, warn or error. debug adds redacted request and response bodies,
# which still contain customer names, emails and phone numbers.
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

# Rate limits in requests per minute (0 disables). Bursts allow ~10 seconds'
# worth of requests at once (minimum 5).
# Per merchant API key:
RATE_LIMIT_MERCHANT_PER_MIN=600
# Per client IP, checked before authentication:
RATE_LIMIT_IP_PER_MIN=1200
# Per client IP on admin endpoints:
RATE_LIMIT_ADMIN_PER_MIN=10

# Set to true only when exactly one reverse proxy / load balancer sits in front
# of the hub, so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# Connection pool per hub instance. Keep instances × max open below the
# database's max_connections.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
